# Copy to .env and fill in. NEVER commit .env.
# In production these come from a secrets manager (AWS Secrets Manager / KMS),
# not from a file on disk.

# Salt for customer_id pseudonymization. Anyone holding this can reverse every
# pseudonym by brute force, so treat it like a password.
# Generate with: openssl rand -hex 32
PII_PSEUDONYM_SALT=

# Where raw data comes from in a real deployment
# SOURCE_S3_BUCKET=
# SOURCE_S3_PREFIX=
